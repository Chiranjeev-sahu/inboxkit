# Every provider is optional. Configure only funded routes you intend to use.
# Agent web search needs no key here. Hosted MCP sign-in is separate from .env.

# Search / page extraction fallbacks
EXA_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# Named-contact discovery fallbacks (some providers also verify)
APOLLO_API_KEY=
PROSPEO_API_KEY=
HUNTER_API_KEY=
FINDYMAIL_API_KEY=
LUSHA_API_KEY=
DATAGMA_API_KEY=

# Icypeas API key is used alone in Authorization. Account email must match it.
ICYPEAS_API_KEY=
ICYPEAS_ACCOUNT_EMAIL=
# Legacy credentials retained for routes that explicitly require them; not used by
# the tested single synchronous finder, verifier or balance calls.
ICYPEAS_API_SECRET=
ICYPEAS_USER_ID=

# Verification fallbacks
BOUNCEBAN_API_KEY=
ZEROBOUNCE_API_KEY=
REOON_API_KEY=
MILLIONVERIFIER_API_KEY=
